# Use the prebuilt protoc shipped by protobuf (>=33.4) instead of compiling
# protoc + abseil from source [for tool]. Without this, proto_library resolves
# protoc from @com_google_protobuf//bazel/private/toolchains:protoc_sources and
# Bazel builds it from source, which needs a C++ toolchain and breaks on RBE
# workers whose GCC builtin include dirs differ from the client's toolchain.
#
# --incompatible_enable_proto_toolchain_resolution is on by default in Bazel 9,
# kept explicit for clarity / older Bazel. The prefer_prebuilt_protoc flag is
# what actually selects the prebuilt binary on protobuf 33.4+.
common --incompatible_enable_proto_toolchain_resolution
common --@com_google_protobuf//bazel/toolchains:prefer_prebuilt_protoc

# This is a pure-Go workspace, so build without cgo. Otherwise rules_go builds
# the Go stdlib with CGO_ENABLED=1 using the client's auto-detected C compiler
# (CC=/nix/store/.../gcc here), whose absolute path does not exist on the RBE
# worker, failing remote actions with "cc: no such file or directory".
common --@rules_go//go/config:pure

# The Namespace RBE Linux workers are x86_64. Pin the execution and target
# platforms so exec-config tools (prebuilt protoc, Go compiler) AND the produced
# binaries match the worker arch, even when the bazel client runs on a different
# arch (e.g. an arm64 CI runner). Without this, an arm64 client fetches the
# arm64 prebuilt protoc and ships it to the x86_64 worker, failing with
# "cannot execute binary file: Exec format error".
common --extra_execution_platforms=//:rbe_linux_amd64
common --platforms=//:rbe_linux_amd64
