module(
    name = "bufbuild",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.55.1")
bazel_dep(name = "apple_support", version = "1.24.2")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "gazelle", version = "0.43.0")

# Hermetic prebuilt protoc. Without this, @com_google_protobuf would build protoc from source and require a C++ toolchain.
bazel_dep(name = "toolchains_protoc", version = "0.4.3")

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(
    google_protobuf = "com_google_protobuf",
    version = "v29.0",
)
register_toolchains("@toolchains_protoc//protoc:all")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.21.5")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.module(
    path = "google.golang.org/protobuf",
    version = "v1.34.2",
    sum = "h1:6xV6lTsCfpGD21XK49h7MhtcApnLqkfYgPcdHftf6hg=",
)
go_deps.module(
    path = "github.com/golang/protobuf",
    version = "v1.5.4",
    sum = "h1:i7eJL8qZTpSEXOPTxNKhASYpMn+8e5Q6AdndVa1dWek=",
)
use_repo(
    go_deps,
    "com_github_golang_protobuf",
    "org_golang_google_protobuf",
)

buf = use_extension("//:extensions.bzl", "buf")
buf.toolchain(version = "1.18.0")
use_repo(
    buf,
    "buf_toolchains",
    "buf_Darwin-arm64",
    "buf_Darwin-x86_64",
    "buf_Linux-aarch64",
    "buf_Linux-x86_64",
)

register_toolchains("@buf_toolchains//:all")
